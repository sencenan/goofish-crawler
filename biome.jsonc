{
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100,
    "indentWidth": 2,
    "quoteStyle": "single"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single", // default is `double`
      "lineWidth": 120 // override `formatter.lineWidth`
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  }
}